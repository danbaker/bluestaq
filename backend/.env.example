# Copy to .env and adjust. .env is git-ignored.
PORT=3001
# Origin of the frontend; the WebSocket only accepts browsers from here.
CLIENT_ORIGIN=http://localhost:5173
# Local Postgres. The database is created automatically on boot.
PGCONNECTIONSTRING=postgresql://userx:pw@localhost:5432/bluestaq_dev?sslmode=disable
# Signs the login cookie. Use a long random value (openssl rand -hex 32).
JWT_SECRET=change-me
# The site admin that is created on first boot (the only user who can create other users).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-too
# Optional: connection URL for the real-Postgres tests (defaults to the local userx server).
# TEST_PGCONNECTIONSTRING=postgresql://userx:pw@localhost:5432/postgres?sslmode=disable
